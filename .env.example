# Copy to .env and fill in. Never commit .env.

# --- api ---
APP_ENV=development            # development | production
PORT=8080
LOG_LEVEL=info                 # debug | info | warn | error
DATABASE_URL=postgres://repright:repright@localhost:55432/repright?sslmode=disable
ALLOWED_ORIGINS=http://localhost:3000
# Phase 1:
GOOGLE_CLIENT_ID=
JWT_SECRET=                    # at least 32 random bytes, e.g. `openssl rand -base64 48`
COOKIE_DOMAIN=localhost

# --- web (apps/web; copy these to apps/web/.env.local) ---
API_ORIGIN=http://localhost:8080      # where Next.js proxies /api/* (server side)
NEXT_PUBLIC_API_URL=/api              # browser calls same-origin /api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
