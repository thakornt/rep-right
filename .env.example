# Copy to .env (repo root) and fill in. Never commit .env.
# Both the API (go run ./cmd/api) and the web app (npm run dev) read this file.
# Keep comments on their own lines: "KEY=   # note" would set KEY to the note.

# --- api ---
# development | production
APP_ENV=development
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
# docker compose Postgres (make up), or a Neon dev branch URL (see README)
DATABASE_URL=postgres://repright:repright@localhost:55432/repright?sslmode=disable
ALLOWED_ORIGINS=http://localhost:3000
# Auth, required by `api serve` (not by `api migrate`).
GOOGLE_CLIENT_ID=
# Optional. Lets the API redeem codes from our own Google button (secret of the
# same OAuth client). Empty = the web shows Google's own button instead.
GOOGLE_CLIENT_SECRET=
# Optional LINE Login channel (LINE Developers console). Set both or neither;
# empty = the LINE button is hidden.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# At least 32 characters, e.g. openssl rand -base64 48. Use a different one in production.
JWT_SECRET=
# Leave empty: host-only cookie, which works through the /api proxy.
COOKIE_DOMAIN=
# Shared by the API and the web's /api proxy: the API refuses requests
# without it, so nobody can call the API host directly. Required in
# production (openssl rand -base64 48, same value on Render and Vercel);
# leave empty locally.
PROXY_SECRET=
# Optional flood protection overrides (empty = built-in default). Rates are
# requests per minute, bursts are how many may arrive at once. Raise the IP
# ones if many users share one IP (e.g. a gym's WiFi).
# defaults: IP 300/60, AUTH 20/10, USER 120/40, MAX_IN_FLIGHT 100
RATE_LIMIT_IP_PER_MIN=
RATE_LIMIT_IP_BURST=
RATE_LIMIT_AUTH_PER_MIN=
RATE_LIMIT_AUTH_BURST=
RATE_LIMIT_USER_PER_MIN=
RATE_LIMIT_USER_BURST=
MAX_IN_FLIGHT=

# --- web ---
# Where Next.js proxies /api/* (server side).
API_ORIGIN=http://localhost:8080
# The browser always calls same-origin /api.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# The site's public address, for the sitemap, robots.txt and shared-link previews
# (LINE, Facebook). Production (Vercel): https://rep-right-th.vercel.app, or the
# custom domain once there is one. Empty on Vercel = its production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
