# Copy to .env (repo root) and fill in. Never commit .env.
# Both the API (go run ./cmd/api) and the web app (npm run dev) read this file.
# Keep comments on their own lines: "KEY=   # note" would set KEY to the note.

# --- api ---
# development | production
APP_ENV=development
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
# docker compose Postgres (make up), or a Neon dev branch URL (see README)
DATABASE_URL=postgres://repright:repright@localhost:55432/repright?sslmode=disable
ALLOWED_ORIGINS=http://localhost:3000
# Auth, required by `api serve` (not by `api migrate`).
GOOGLE_CLIENT_ID=
# At least 32 characters, e.g. openssl rand -base64 48. Use a different one in production.
JWT_SECRET=
# Leave empty: host-only cookie, which works through the /api proxy.
COOKIE_DOMAIN=

# --- web ---
# Where Next.js proxies /api/* (server side).
API_ORIGIN=http://localhost:8080
# The browser always calls same-origin /api.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
